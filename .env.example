# Copy this file to .env for Docker Compose, then replace the placeholder.
JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost
EMAIL_FROM=PassItOn <no-reply@passiton.local>
RESEND_VERIFICATION_COOLDOWN_SECONDS=60


# SMTP settings for verification emails. Leave SMTP_HOST blank for local
# development; the backend will log the verification link instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

SEED_DEMO_USER=false
