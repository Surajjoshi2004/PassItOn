PORT=5000
MONGO_URI=mongodb://localhost:27017/passiton
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-super-secret-change-me
JWT_EXPIRES_IN=7d
GRADUATING_SOON_WINDOW_DAYS=90

# Public URL of the frontend used in verification emails.
APP_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=15
RESEND_VERIFICATION_COOLDOWN_SECONDS=60

# SMTP is required for real email delivery. Leave SMTP_HOST blank in local
# development to print the verification link in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PassItOn <no-reply@passiton.local>

# Set to true only for local testing. This creates a verified demo account.
SEED_DEMO_USER=false
DEMO_USER_EMAIL=demo@lpu.in
DEMO_USER_PASSWORD=DemoPass123!
